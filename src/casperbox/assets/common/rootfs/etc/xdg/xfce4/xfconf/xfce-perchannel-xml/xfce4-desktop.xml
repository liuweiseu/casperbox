<?xml version="1.0" encoding="UTF-8"?>
<!--
  casperbox default XFCE wallpaper (system-wide; a user's own setting in
  ~/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml takes precedence).
  The backdrop is keyed by monitor name: VNC-0 is the TigerVNC output (xfdesktop >= 4.14),
  monitor0 the name used by older xfdesktop. image-style 5 = zoomed (fills the screen).
-->
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
        <property name="monitorVNC-0" type="empty">
          <property name="workspace0" type="empty">
            <property name="last-image" type="string" value="/usr/share/backgrounds/casperbox/casper-wallpaper.png"/>
            <property name="image-style" type="int" value="5"/>
            <property name="color-style" type="int" value="0"/>
            <property name="rgba1" type="array">
              <value type="double" value="0.020000"/>
              <value type="double" value="0.040000"/>
              <value type="double" value="0.086000"/>
              <value type="double" value="1.000000"/>
            </property>
          </property>
          <property name="workspace1" type="empty">
            <property name="last-image" type="string" value="/usr/share/backgrounds/casperbox/casper-wallpaper.png"/>
            <property name="image-style" type="int" value="5"/>
            <property name="color-style" type="int" value="0"/>
            <property name="rgba1" type="array">
              <value type="double" value="0.020000"/>
              <value type="double" value="0.040000"/>
              <value type="double" value="0.086000"/>
              <value type="double" value="1.000000"/>
            </property>
          </property>
