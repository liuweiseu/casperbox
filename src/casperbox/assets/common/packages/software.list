# Base apt packages of the casperbox (toolflow) image, installed for every toolflow version
# by common/scripts/install_base.sh. Packages a version needs in addition (e.g. the Vivado
# runtime dependencies) are listed in versions/<version>/pkgs.list.
# One package per line; text after # is ignored.
# A trailing "?" marks an optional package: installed only if the OS release has it.

# ---- basic tools ----
ca-certificates
curl
wget
git
sudo
locales
tzdata
bzip2
xz-utils
unzip
file
less
vim
nano
procps
psmisc
iproute2
iputils-ping
net-tools
lsb-release

# ---- build tools ----
build-essential
make
gcc
g++
device-tree-compiler

# ---- ssh / vnc / desktop ----
openssh-server
tigervnc-standalone-server
tigervnc-common
# xauth: used by vncserver; not pulled in with --no-install-recommends
xauth
# vncpasswd: separate package since TigerVNC 1.11 (Ubuntu 22.04+); in tigervnc-common on Ubuntu 20.04
tigervnc-tools?
xfce4
xfce4-terminal
dbus-x11
x11-xserver-utils
x11-utils
xfonts-base
fonts-dejavu
firefox

