# Extra apt packages for toolflow m2021a, installed after common/packages/software.list.
# One package per line; text after # is ignored.
# A trailing "?" marks an optional package: installed only if the OS release has it.

# ---- Vivado 2021.1 runtime dependencies ----
libncurses5
libx11-6
libxext6
libxrender1
libxtst6
libxi6
libxft2
libxrandr2
libxcursor1
libxinerama1
libsm6
libice6
libfreetype6
libfontconfig1
libglib2.0-0
libgtk2.0-0
libgtk-3-0
libcanberra-gtk-module
libcanberra-gtk3-module
libasound2
libgl1
libglu1-mesa

# ---- Vivado 2021.1 scripts/installLibs.sh (Ubuntu part) ----
# Listed here instead of running the script: it ignores apt errors (every apt-get is piped
# into tee), so a missing package would not fail the build.
libc6-dev-i386
net-tools
graphviz
make
unzip
g++
libtinfo5
xvfb
git
