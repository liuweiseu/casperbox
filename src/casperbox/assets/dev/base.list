# Base apt packages of the casperbox-dev image (installed by common/scripts/install_base.sh).
# Extra packages come from `packages` in casper-dev.toml.
# A trailing "?" marks an optional package: installed only if the OS release has it.

# ---- basic tools ----
ca-certificates
curl
sudo
locales
tzdata
procps
iproute2
iputils-ping
less
nano

# ---- ssh / vnc / desktop ----
openssh-server
tigervnc-standalone-server
tigervnc-common
# vncpasswd: separate package since TigerVNC 1.11; in tigervnc-common on Ubuntu 20.04
tigervnc-tools?
xfce4
xfce4-terminal
dbus-x11
x11-xserver-utils
x11-utils
xfonts-base
fonts-dejavu
