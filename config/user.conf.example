# =============================================================================
# casper-container 用户配置
#
# 使用方法：cp config/user.conf.example config/user.conf，然后修改 user.conf。
# 本文件为 bash 语法，路径中的 ~ 会展开为宿主机 $HOME，相对路径相对于仓库根目录。
# =============================================================================

# -----------------------------------------------------------------------------
# 必需目录（宿主机路径）
# -----------------------------------------------------------------------------
# Vivado 安装目录（其下应有 Vivado/<版本>/settings64.sh），挂载到容器 /tools/Xilinx
VIVADO_DIR=/tools/Xilinx
# Vivado 挂载方式：ro（只读，推荐）或 rw
VIVADO_MOUNT_OPTS=ro

# Xilinx license 目录，挂载到容器 ~/.Xilinx
XIL_LICENSE_DIR=~/.Xilinx

# 工作目录，挂载到容器 ~/work（不存在时自动创建）
WORK_DIR=~/casper_work

# -----------------------------------------------------------------------------
# 必需端口（宿主机端口）
# -----------------------------------------------------------------------------
SSH_PORT=2222        # -> 容器 22
VNC_PORT=5901        # -> 容器 5901

# 端口绑定地址：0.0.0.0 允许其它机器访问，127.0.0.1 仅本机访问
BIND_ADDRESS=0.0.0.0

# -----------------------------------------------------------------------------
# 账户
# -----------------------------------------------------------------------------
# 容器用户名（修改后需要重新 build）
CONTAINER_USER=casper
# SSH 登录密码（同时也是 sudo 密码），启动时设置，修改后重新 up 即可
CONTAINER_PWD=casper
# VNC 密码（6~8 位，超过 8 位只有前 8 位有效）
VNC_PASSWORD=casper

# -----------------------------------------------------------------------------
# 可选：用户自定义挂载
# 格式："宿主机路径:容器路径[:选项]"，选项可为 ro / rw
# 容器路径可用 ~/ 表示容器用户的根目录
# -----------------------------------------------------------------------------
EXTRA_MOUNTS=(
    # "~/datasets:~/datasets:ro"
    # "/opt/matlab:/opt/matlab:ro"
)

# -----------------------------------------------------------------------------
# 可选：用户自定义端口
# 格式："宿主机端口:容器端口[/tcp|/udp]"
# -----------------------------------------------------------------------------
EXTRA_PORTS=(
    # "8888:8888"
)

# -----------------------------------------------------------------------------
# 可选：容器网卡 (eth0) 的 MAC 地址
# 容器使用 pasta 网络，MAC 通过 pasta 的 --ns-mac-addr 设置。
# 例如使用绑定 MAC 的 Xilinx node-locked license 时，填写 license 对应的 MAC。
# 格式 xx:xx:xx:xx:xx:xx，留空则随机分配。
# -----------------------------------------------------------------------------
CONTAINER_MAC=

# -----------------------------------------------------------------------------
# 其它（一般无需修改）
# -----------------------------------------------------------------------------
# 容器名，留空则为 casper-<版本>
CONTAINER_NAME=
VNC_GEOMETRY=1920x1080
SHM_SIZE=2g
TZ=Asia/Shanghai
