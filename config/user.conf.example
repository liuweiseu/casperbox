# =============================================================================
# casper-container user configuration
#
# Usage: cp config/user.conf.example config/user.conf, then edit user.conf.
# Bash syntax. ~ in paths expands to the host $HOME; relative paths are relative to the repo root.
# =============================================================================

# -----------------------------------------------------------------------------
# Required directories (host paths)
# -----------------------------------------------------------------------------
# Vivado install directory, mounted at the same path in the container.
# Either the Xilinx install root (containing Vivado/<version>/settings64.sh)
# or the Vivado directory itself (containing settings64.sh).
VIVADO_DIR=/tools/Xilinx
# Vivado mount mode: ro (read-only, recommended) or rw
VIVADO_MOUNT_OPTS=ro

# Xilinx license directory, mounted at ~/.Xilinx in the container
XIL_LICENSE_DIR=~/.Xilinx

# Work directory, mounted at ~/work in the container (created if missing)
WORK_DIR=~/casper_work

# -----------------------------------------------------------------------------
# Required ports (host ports)
# -----------------------------------------------------------------------------
SSH_PORT=2222        # -> container 22
VNC_PORT=5901        # -> container 5901

# Bind address: 0.0.0.0 allows access from other machines, 127.0.0.1 is local only
BIND_ADDRESS=0.0.0.0

# -----------------------------------------------------------------------------
# Accounts
# -----------------------------------------------------------------------------
# Container user name (rebuild after changing)
CONTAINER_USER=casper
# SSH login password (also the sudo password), applied at startup; just run up again after changing
CONTAINER_PWD=casper
# VNC password (6-8 characters; only the first 8 are used)
VNC_PASSWORD=casper

# -----------------------------------------------------------------------------
# Optional: extra mounts
# Format: "host_path:container_path[:option]", option is ro / rw
# In the container path, ~/ means the container user's home directory
# -----------------------------------------------------------------------------
EXTRA_MOUNTS=(
    # "~/datasets:~/datasets:ro"
    # "/opt/matlab:/opt/matlab:ro"
)

# -----------------------------------------------------------------------------
# Optional: extra ports
# Format: "host_port:container_port[/tcp|/udp]"
# -----------------------------------------------------------------------------
EXTRA_PORTS=(
    # "8888:8888"
)

# -----------------------------------------------------------------------------
# Optional: MAC address of the container interface (eth0)
# The container uses pasta networking; the MAC is set via pasta's --ns-mac-addr.
# E.g. for a MAC-locked Xilinx node-locked license, set the MAC from the license.
# Format xx:xx:xx:xx:xx:xx; leave empty for a random one.
# -----------------------------------------------------------------------------
CONTAINER_MAC=

# -----------------------------------------------------------------------------
# Misc (usually no need to change)
# -----------------------------------------------------------------------------
# Container name; empty means casper-<version>
CONTAINER_NAME=
VNC_GEOMETRY=1920x1080
SHM_SIZE=2g
TZ=Asia/Shanghai
